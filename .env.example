# GitHub Pages project site: https://<user>.github.io/<repo>/
# Keep this as /tools for the mhxw/tools repository.
# Use NEXT_PUBLIC_BASE_PATH="" when deploying to a custom domain root.
NEXT_PUBLIC_BASE_PATH=/tools
NEXT_PUBLIC_SITE_URL=https://mhxw.github.io/tools

# Optional: override the default public RPC endpoints.

# Mainnets
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org
NEXT_PUBLIC_BASE_RPC_URL=https://base-rpc.publicnode.com
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
NEXT_PUBLIC_OPTIMISM_RPC_URL=https://optimism-rpc.publicnode.com
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz

# Testnets
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
